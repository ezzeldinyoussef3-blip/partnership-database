<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Direct Study | Partnership Database</title>

  <style>
    :root {
      --direct-orange: #f15a24;
      --direct-orange-light: #fff2ec;
      --direct-navy: #082b55;
      --direct-navy-2: #143e68;
      --direct-light: #f7f9fc;
      --direct-border: #e1e7ee;
      --direct-text: #243d55;
      --direct-grey: #7b8997;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family:
        Arial,
        Helvetica,
        sans-serif;

      background: #ffffff;
      color: var(--direct-text);
    }

    /* =====================================
       HERO
    ===================================== */

    .direct-hero {
      position: relative;
      min-height: 350px;

      overflow: hidden;

      padding:
        55px
        7%
        95px;

      background:
        radial-gradient(
          circle at 78% 45%,
          rgba(241, 90, 36, 0.10),
          rgba(241, 90, 36, 0.03) 25%,
          transparent 48%
        ),
        #ffffff;
    }

    /* WORLD MAP EFFECT */

    .direct-hero::before {
      content: "";

      position: absolute;

      width: 570px;
      height: 280px;

      right: 6%;
      top: 62px;

      opacity: 0.13;

      background-image:
        radial-gradient(
          circle,
          #365d82 1.6px,
          transparent 1.8px
        );

      background-size:
        10px
        10px;

      -webkit-mask-image:
        radial-gradient(
          ellipse at center,
          #000 10%,
          transparent 73%
        );

      mask-image:
        radial-gradient(
          ellipse at center,
          #000 10%,
          transparent 73%
        );
    }

    /* LARGE ORANGE CURVE */

    .direct-hero::after {
      content: "";

      position: absolute;

      width: 850px;
      height: 380px;

      right: -330px;
      bottom: -275px;

      border:
        20px
        solid
        var(--direct-orange);

      border-radius: 50%;

      opacity: 0.95;
    }

    /* NAVY CURVE */

    .hero-navy-curve {
      position: absolute;

      width: 900px;
      height: 370px;

      right: -365px;
      bottom: -300px;

      border:
        38px
        solid
        var(--direct-navy);

      border-radius: 50%;

      z-index: 0;
    }

    /* FLIGHT LINE */

    .flight-line {
      position: absolute;

      right: 6%;
      top: 188px;

      width: 330px;
      height: 130px;

      border-top:
        3px
        solid
        var(--direct-orange);

      border-radius: 50%;

      transform:
        rotate(8deg);

      opacity: 0.8;
    }

    .flight-line::after {
      content: "✈";

      position: absolute;

      left: -3px;
      top: -25px;

      font-size: 35px;

      color:
        var(--direct-orange);

      transform:
        rotate(-7deg);
    }

    /* TOP DECORATION */

    .top-orange-decoration {
      position: absolute;

      left: 0;
      top: 0;

      width: 130px;
      height: 20px;

      background:
        var(--direct-orange);
    }

    .top-navy-decoration {
      position: absolute;

      left: 0;
      top: 20px;

      width: 85px;
      height: 10px;

      background:
        var(--direct-navy);
    }

    /* HERO CONTENT */

    .hero-inner {
      position: relative;

      z-index: 3;

      max-width: 820px;
    }

    .hero-title {
      margin: 0;

      font-size: 54px;
      line-height: 1.04;

      color:
        var(--direct-navy);

      font-weight: 800;

      letter-spacing:
        -1.5px;
    }

    .hero-title .orange {
      color:
        var(--direct-orange);
    }

    .hero-line {
      width: 95px;
      height: 6px;

      margin:
        25px
        0;

      border-radius: 10px;

      background:
        var(--direct-orange);
    }

    .hero-text {
      max-width: 700px;

      margin: 0;

      font-size: 19px;
      line-height: 1.55;

      color:
        #536b80;
    }

    /* DIRECT LOGO */

    .direct-logo {
      position: absolute;

      top: 27px;
      right: 5%;

      z-index: 8;

      width: 115px;
      height: 115px;

      object-fit: contain;

      background:
        #ffffff;

      border-radius:
        50%;

      padding: 4px;
    }

    /* =====================================
       DATABASE / FILTERS
    ===================================== */

    .database-wrapper {
      position: relative;

      z-index: 10;

      max-width: 1500px;

      margin:
        -55px
        auto
        45px;

      padding:
        0
        28px;
    }

    .filters-card {
      background:
        #ffffff;

      border:
        1px
        solid
        var(--direct-border);

      border-radius:
        22px;

      padding:
        26px;

      box-shadow:
        0 18px 50px rgba(8, 43, 85, 0.09),
        0 3px 10px rgba(8, 43, 85, 0.04);
    }

    .filters-heading {
      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      gap:
        20px;

      margin-bottom:
        22px;
    }

    .filters-title {
      margin: 0;

      color:
        var(--direct-navy);

      font-size:
        23px;

      font-weight:
        800;
    }

    .clear-button {
      border: none;

      background:
        #fff2ec;

      color:
        var(--direct-orange);

      padding:
        9px
        16px;

      border-radius:
        20px;

      cursor:
        pointer;

      font-weight:
        700;

      transition:
        0.2s;
    }

    .clear-button:hover {
      background:
        var(--direct-orange);

      color:
        #ffffff;
    }

    .filters-grid {
      display:
        grid;

      grid-template-columns:
        repeat(6, 1fr);

      gap:
        14px;
    }

    .filter-group {
      min-width: 0;
    }

    .filter-group label {
      display:
        block;

      margin:
        0
        0
        7px
        3px;

      font-size:
        13px;

      font-weight:
        700;

      color:
        var(--direct-navy);
    }

    .filter-group select,
    .filter-group input {
      width:
        100%;

      height:
        49px;

      padding:
        0
        14px;

      border:
        1px
        solid
        #d8e0e8;

      border-radius:
        12px;

      background:
        #ffffff;

      color:
        var(--direct-text);

      font-size:
        14px;

      outline:
        none;

      transition:
        0.2s;
    }

    .filter-group input::placeholder {
      color:
        #a1acb7;
    }

    .filter-group select:focus,
    .filter-group input:focus {
      border-color:
        var(--direct-orange);

      box-shadow:
        0
        0
        0
        3px
        rgba(241, 90, 36, 0.10);
    }

    .search-box {
      grid-column:
        span
        2;
    }

    .search-box input {
      background:
        #fafbfd;
    }

    /* =====================================
       RESULTS
    ===================================== */

    .results-section {
      max-width:
        1500px;

      margin:
        auto;

      padding:
        0
        28px
        80px;
    }

    .results-header {
      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      gap:
        20px;

      margin-bottom:
        22px;
    }

    .results-header h2 {
      margin: 0;

      color:
        var(--direct-navy);

      font-size:
        24px;
    }

    .results-count {
      display:
        inline-block;

      padding:
        8px
        15px;

      border-radius:
        40px;

      background:
        var(--direct-orange-light);

      color:
        var(--direct-orange);

      font-size:
        13px;

      font-weight:
        800;
    }

    .results-grid {
      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }

    /* RESULT CARD */

    .result-card {
      position:
        relative;

      overflow:
        hidden;

      padding:
        22px;

      background:
        #ffffff;

      border:
        1px
        solid
        var(--direct-border);

      border-radius:
        17px;

      transition:
        all
        0.23s
        ease;
    }

    .result-card::before {
      content: "";

      position:
        absolute;

      left:
        0;

      top:
        0;

      width:
        100%;

      height:
        4px;

      background:
        linear-gradient(
          90deg,
          var(--direct-orange),
          #ff8f58
        );
    }

    .result-card:hover {
      transform:
        translateY(-4px);

      border-color:
        #ccd5df;

      box-shadow:
        0 14px 32px rgba(8, 43, 85, 0.10);
    }

    .university-name {
      margin:
        0
        0
        16px;

      min-height:
        45px;

      color:
        var(--direct-navy);

      font-size:
        18px;

      line-height:
        1.3;
    }

    .result-row {
      margin:
        11px
        0;
    }

    .result-label {
      display:
        block;

      margin-bottom:
        3px;

      color:
        #8b99a6;

      font-size:
        11px;

      font-weight:
        800;

      letter-spacing:
        0.5px;

      text-transform:
        uppercase;
    }

    .result-value {
      display:
        block;

      color:
        #294258;

      font-size:
        14px;

      font-weight:
        600;

      line-height:
        1.4;
    }

    .partner-badge {
      display:
        inline-block;

      margin-top:
        12px;

      padding:
        6px
        12px;

      border-radius:
        30px;

      background:
        #fff1ea;

      color:
        var(--direct-orange);

      font-size:
        12px;

      font-weight:
        800;
    }

    .country-badge {
      display:
        inline-block;

      margin:
        12px
        5px
        0
        0;

      padding:
        6px
        12px;

      border-radius:
        30px;

      background:
        #edf4fa;

      color:
        var(--direct-navy);

      font-size:
        12px;

      font-weight:
        800;
    }

    /* NO RESULTS */

    .no-results {
      grid-column:
        1 / -1;

      padding:
        65px
        20px;

      text-align:
        center;

      border:
        1px
        dashed
        #d5dde5;

      border-radius:
        16px;

      color:
        #7c8d9b;

      background:
        #fafbfd;
    }

    .no-results h3 {
      margin:
        0
        0
        8px;

      color:
        var(--direct-navy);
    }

    /* =====================================
       FOOTER
    ===================================== */

    .direct-footer {
      padding:
        24px;

      text-align:
        center;

      background:
        var(--direct-navy);

      color:
        rgba(255, 255, 255, 0.82);

      font-size:
        13px;

      border-top:
        5px
        solid
        var(--direct-orange);
    }

    /* =====================================
       RESPONSIVE
    ===================================== */

    @media (max-width: 1200px) {

      .filters-grid {
        grid-template-columns:
          repeat(3, 1fr);
      }

      .search-box {
        grid-column:
          span
          2;
      }

      .results-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }
    }

    @media (max-width: 780px) {

      .direct-hero {
        min-height:
          335px;

        padding:
          125px
          25px
          75px;
      }

      .hero-title {
        font-size:
          38px;
      }

      .hero-text {
        font-size:
          16px;
      }

      .direct-logo {
        width:
          90px;

        height:
          90px;

        right:
          22px;

        top:
          23px;
      }

      .direct-hero::before {
        display:
          none;
      }

      .flight-line {
        opacity:
          0.28;
      }

      .filters-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .search-box {
        grid-column:
          span
          2;
      }

      .database-wrapper {
        margin-top:
          -38px;

        padding:
          0
          16px;
      }

      .results-section {
        padding-left:
          16px;

        padding-right:
          16px;
      }

      .results-grid {
        grid-template-columns:
          1fr;
      }
    }

    @media (max-width: 520px) {

      .filters-grid {
        grid-template-columns:
          1fr;
      }

      .search-box {
        grid-column:
          auto;
      }

      .filters-heading {
        align-items:
          flex-start;

        flex-direction:
          column;
      }

      .hero-title {
        font-size:
          32px;
      }

      .results-header {
        align-items:
          flex-start;

        flex-direction:
          column;
      }
    }
  </style>
</head>

<body>

  <!-- ======================================
       HERO
  ======================================= -->

  <section class="direct-hero">

    <div class="top-orange-decoration"></div>
    <div class="top-navy-decoration"></div>

    <img
      src="direct-logo.png"
      alt="Direct Study"
      class="direct-logo"
    >

    <div class="hero-navy-curve"></div>
    <div class="flight-line"></div>

    <div class="hero-inner">

      <h1 class="hero-title">
        <span class="orange">
          Direct Study
        </span>
        <br>
        Partnership Database
      </h1>

      <div class="hero-line"></div>

      <p class="hero-text">
        Search universities, study programs and international education
        partnerships available through Direct Study.
      </p>

    </div>

  </section>


  <!-- ======================================
       FILTERS
  ======================================= -->

  <div class="database-wrapper">

    <div class="filters-card">

      <div class="filters-heading">

        <h2 class="filters-title">
          Find Study Options
        </h2>

        <button
          class="clear-button"
          onclick="clearFilters()"
        >
          Clear Filters
        </button>

      </div>

      <div class="filters-grid">

        <!-- SEARCH -->

        <div class="filter-group search-box">

          <label>
            Search
          </label>

          <input
            type="text"
            id="searchInput"
            placeholder="Search university or program..."
          >

        </div>


        <!-- SPECIALIZATION -->

        <div class="filter-group">

          <label>
            Specialization
          </label>

          <select id="specializationFilter">

            <option value="">
              All Specializations
            </option>

          </select>

        </div>


        <!-- UNIVERSITY -->

        <div class="filter-group">

          <label>
            University
          </label>

          <select id="universityFilter">

            <option value="">
              All Universities
            </option>

          </select>

        </div>


        <!-- COUNTRY -->

        <div class="filter-group">

          <label>
            Country
          </label>

          <select id="countryFilter">

            <option value="">
              All Countries
            </option>

          </select>

        </div>


        <!-- PARTNERSHIP -->

        <div class="filter-group">

          <label>
            Partnership
          </label>

          <select id="partnershipFilter">

            <option value="">
              All Partnerships
            </option>

          </select>

        </div>


        <!-- DEGREE -->

        <div class="filter-group">

          <label>
            Degree
          </label>

          <select id="degreeFilter">

            <option value="">
              All Degrees
            </option>

          </select>

        </div>

      </div>

    </div>

  </div>


  <!-- ======================================
       RESULTS
  ======================================= -->

  <section class="results-section">

    <div class="results-header">

      <h2>
        Available Study Options
      </h2>

      <div
        class="results-count"
        id="resultsCount"
      >
        0 Results
      </div>

    </div>

    <div
      id="results"
      class="results-grid"
    ></div>

  </section>


  <!-- ======================================
       FOOTER
  ======================================= -->

  <footer class="direct-footer">

    Direct Study Partnership Database

  </footer>


  <!-- ======================================
       JAVASCRIPT
  ======================================= -->

  <script>

    /* ===================================================
       YOUR UNIVERSITY DATABASE
       ضع بياناتك الحالية هنا
    =================================================== */

    const universityData = [

      /*
      EXAMPLE:

      {
        specialization: "Computer Science",
        university: "Arizona State University",
        partnership: "Kaplan",
        degree: "Bachelor",
        country: "USA"
      },

      {
        specialization: "Supply Chain Management",
        university: "University of Liverpool",
        partnership: "Kaplan",
        degree: "Master",
        country: "UK"
      },

      {
        specialization: "Business Administration",
        university: "University of Oregon",
        partnership: "Kaplan",
        degree: "Bachelor",
        country: "USA"
      }
      */

      /* =========================================
         PASTE YOUR CURRENT DATABASE HERE
      ========================================== */

    ];


    /* ===================================================
       NORMALIZE DATA
    =================================================== */

    function normalize(value) {

      return String(value || "")
        .trim();

    }


    /* ===================================================
       REMOVE DUPLICATES
    =================================================== */

    function removeDuplicates(data) {

      const seen =
        new Set();

      return data.filter(item => {

        const key = [

          normalize(item.specialization),
          normalize(item.university),
          normalize(item.partnership),
          normalize(item.degree),
          normalize(item.country)

        ]
        .join("|")
        .toLowerCase();

        if (seen.has(key)) {

          return false;

        }

        seen.add(key);

        return true;

      });

    }


    const cleanData =
      removeDuplicates(
        universityData
      );


    /* ===================================================
       GET UNIQUE VALUES
    =================================================== */

    function uniqueValues(field) {

      return [

        ...new Set(

          cleanData
            .map(item =>
              normalize(item[field])
            )
            .filter(Boolean)

        )

      ]
      .sort(
        (a, b) =>
          a.localeCompare(b)
      );

    }


    /* ===================================================
       POPULATE SELECT
    =================================================== */

    function populateSelect(
      id,
      values
    ) {

      const select =
        document.getElementById(id);

      values.forEach(value => {

        const option =
          document.createElement(
            "option"
          );

        option.value =
          value;

        option.textContent =
          value;

        select.appendChild(
          option
        );

      });

    }


    /* ===================================================
       BUILD FILTER OPTIONS
    =================================================== */

    function populateFilters() {

      populateSelect(
        "specializationFilter",
        uniqueValues(
          "specialization"
        )
      );

      populateSelect(
        "universityFilter",
        uniqueValues(
          "university"
        )
      );

      populateSelect(
        "countryFilter",
        uniqueValues(
          "country"
        )
      );

      populateSelect(
        "partnershipFilter",
        uniqueValues(
          "partnership"
        )
      );

      populateSelect(
        "degreeFilter",
        uniqueValues(
          "degree"
        )
      );

    }


    /* ===================================================
       CREATE RESULT CARD
    =================================================== */

    function createResultCard(
      item
    ) {

      return `

        <div class="result-card">

          <h3 class="university-name">

            ${escapeHTML(
              item.university
            )}

          </h3>


          <div class="result-row">

            <span class="result-label">
              Specialization
            </span>

            <span class="result-value">

              ${escapeHTML(
                item.specialization
              )}

            </span>

          </div>


          <div class="result-row">

            <span class="result-label">
              Degree
            </span>

            <span class="result-value">

              ${escapeHTML(
                item.degree
              )}

            </span>

          </div>


          <div class="result-row">

            <span class="result-label">
              Country
            </span>

            <span class="result-value">

              ${
                escapeHTML(
                  item.country
                ) || "-"
              }

            </span>

          </div>


          <span class="partner-badge">

            ${
              escapeHTML(
                item.partnership
              ) || "Partnership"
            }

          </span>


          ${
            item.country
              ? `

                <span class="country-badge">

                  ${escapeHTML(
                    item.country
                  )}

                </span>

              `
              : ""
          }

        </div>

      `;

    }


    /* ===================================================
       HTML SAFETY
    =================================================== */

    function escapeHTML(value) {

      const div =
        document.createElement(
          "div"
        );

      div.textContent =
        normalize(value);

      return div.innerHTML;

    }


    /* ===================================================
       FILTER RESULTS
    =================================================== */

    function filterResults() {

      const search =
        document
          .getElementById(
            "searchInput"
          )
          .value
          .trim()
          .toLowerCase();


      const specialization =
        document
          .getElementById(
            "specializationFilter"
          )
          .value;


      const university =
        document
          .getElementById(
            "universityFilter"
          )
          .value;


      const country =
        document
          .getElementById(
            "countryFilter"
          )
          .value;


      const partnership =
        document
          .getElementById(
            "partnershipFilter"
          )
          .value;


      const degree =
        document
          .getElementById(
            "degreeFilter"
          )
          .value;


      const filtered =
        cleanData.filter(item => {

          const searchText = [

            item.specialization,
            item.university,
            item.partnership,
            item.degree,
            item.country

          ]
          .join(" ")
          .toLowerCase();


          const matchesSearch =

            !search ||

            searchText.includes(
              search
            );


          const matchesSpecialization =

            !specialization ||

            normalize(
              item.specialization
            ) === specialization;


          const matchesUniversity =

            !university ||

            normalize(
              item.university
            ) === university;


          const matchesCountry =

            !country ||

            normalize(
              item.country
            ) === country;


          const matchesPartnership =

            !partnership ||

            normalize(
              item.partnership
            ) === partnership;


          const matchesDegree =

            !degree ||

            normalize(
              item.degree
            ) === degree;


          return (

            matchesSearch &&

            matchesSpecialization &&

            matchesUniversity &&

            matchesCountry &&

            matchesPartnership &&

            matchesDegree

          );

        });


      renderResults(
        filtered
      );

    }


    /* ===================================================
       RENDER RESULTS
    =================================================== */

    function renderResults(
      data
    ) {

      const resultsContainer =
        document.getElementById(
          "results"
        );


      const resultsCount =
        document.getElementById(
          "resultsCount"
        );


      resultsCount.textContent =

        `${data.length.toLocaleString()} Results`;


      if (
        data.length === 0
      ) {

        resultsContainer.innerHTML = `

          <div class="no-results">

            <h3>
              No Study Options Found
            </h3>

            <p>
              Try changing your search
              or filters.
            </p>

          </div>

        `;

        return;

      }


      resultsContainer.innerHTML =

        data
          .map(
            createResultCard
          )
          .join("");

    }


    /* ===================================================
       CLEAR FILTERS
    =================================================== */

    function clearFilters() {

      document.getElementById(
        "searchInput"
      ).value = "";


      document.getElementById(
        "specializationFilter"
      ).value = "";


      document.getElementById(
        "universityFilter"
      ).value = "";


      document.getElementById(
        "countryFilter"
      ).value = "";


      document.getElementById(
        "partnershipFilter"
      ).value = "";


      document.getElementById(
        "degreeFilter"
      ).value = "";


      filterResults();

    }


    /* ===================================================
       EVENT LISTENERS
    =================================================== */

    document
      .getElementById(
        "searchInput"
      )
      .addEventListener(
        "input",
        filterResults
      );


    [

      "specializationFilter",
      "universityFilter",
      "countryFilter",
      "partnershipFilter",
      "degreeFilter"

    ]
    .forEach(id => {

      document
        .getElementById(id)
        .addEventListener(
          "change",
          filterResults
        );

    });


    /* ===================================================
       START DATABASE
    =================================================== */

    populateFilters();

    renderResults(
      cleanData
    );

  </script>

</body>

</html>
